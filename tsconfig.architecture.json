{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "erasableSyntaxOnly": true,
    "rootDir": "scripts/architecture-proof",
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": ["scripts/architecture-proof/**/*.ts"]
}
