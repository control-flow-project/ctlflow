{
  "name": "@ctlflow/workspace",
  "version": "0.1.20",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jeswin P Kumar <jeswinpk@agilehead.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.17.0"
  },
  "workspaces": [
    "services/*",
    "services/*/apps/*",
    "services/*/packages/*"
  ],
  "scripts": {
    "typecheck": "node scripts/workspaces.mjs typecheck",
    "build": "node scripts/workspaces.mjs build",
    "test": "node scripts/workspaces.mjs test",
    "test:browser": "node scripts/test.mjs crossfire browser",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:architecture": "npm run verify:structure && npm run verify:architecture --workspace=@ctlflow/crossfire",
    "verify:installation": "npm run verify:installation --workspace=@ctlflow/crossfire",
    "verify:container": "node scripts/verify-container.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.2",
    "@types/sanitize-html": "2.16.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  }
}
