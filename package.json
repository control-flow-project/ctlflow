{
  "name": "crossfire",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "crossfire": "./crossfire"
  },
  "type": "module",
  "description": "Local, human-observed coordination for manually started agents",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.ts",
    "generate:matrix": "node scripts/generate-matrix-api.ts",
    "test": "node --test scripts/*.test.ts",
    "crossfire": "node crossfire",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/manage.ts start",
    "verify": "node scripts/verify.ts",
    "verify:codex": "node --test scripts/native-tests/codex.test.ts",
    "verify:architecture": "node scripts/verify-architecture.ts",
    "verify:startup": "node scripts/verify-startup.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/sanitize-html": "2.16.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@tinqerjs/better-sqlite3-adapter": "0.0.27",
    "@tinqerjs/tinqer": "0.0.27",
    "better-sqlite3": "13.0.3",
    "marked": "18.0.13",
    "proper-lockfile": "4.1.2",
    "sanitize-html": "2.17.7",
    "ws": "8.21.3"
  }
}
