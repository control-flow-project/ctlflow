{
  "name": "@ctlflow/workspace",
  "version": "0.1.21",
  "license": "MIT",
  "author": "Jeswin P Kumar <jeswinpk@agilehead.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.17.0"
  },
  "workspaces": [
    "services/*",
    "services/*/apps/*",
    "services/*/node/apps/*",
    "services/*/node/packages/*",
    "services/*/database"
  ],
  "scripts": {
    "typecheck": "node scripts/workspaces.mjs typecheck",
    "build": "node scripts/workspaces.mjs build",
    "test": "node scripts/workspaces.mjs test",
    "test:rust": "node scripts/verify-rust.mjs",
    "verify:rust": "node scripts/verify-rust-release.mjs",
    "test:browser": "node scripts/test.mjs crossfire browser",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:architecture": "npm run verify:structure && npm run verify:architecture --workspace=@ctlflow/crossfire",
    "verify:installation": "npm run verify:installation --workspace=@ctlflow/crossfire",
    "verify:container": "node scripts/verify-container.mjs",
    "verify:csharp": "node services/crossfire/csharp/scripts/verify.mjs && node services/crossfire/csharp/scripts/verify-runtime.mjs",
    "verify:csharp:core": "node services/crossfire/csharp/scripts/verify.mjs",
    "verify:csharp:runtime": "node services/crossfire/csharp/scripts/verify-runtime.mjs",
    "publish:csharp": "node scripts/publish-csharp.mjs",
    "publish:rust": "node scripts/publish-rust.mjs",
    "package:containers": "node scripts/container-packages.mjs",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:parity": "node scripts/verify-parity.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.2",
    "@types/sanitize-html": "2.16.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  }
}
