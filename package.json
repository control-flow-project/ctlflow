{
  "name": "crossfire",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "crossfire": "./crossfire"
  },
  "type": "module",
  "description": "Local, human-observed coordination for manually started agents",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=180000 dist/tests/*.test.js dist/scripts/*.test.js dist/scripts/native-tests/*.test.js",
    "test:browser": "npm run build && node --test dist/tests/browser.test.js",
    "generate:matrix": "npm run build && node dist/scripts/generate-matrix-api.js",
    "start": "node crossfire start",
    "crossfire": "node crossfire",
    "verify:architecture": "node scripts/verify-architecture.ts",
    "verify:installation": "node scripts/verify-architecture.ts installation",
    "verify:container": "npm run build && node dist/scripts/verify-container.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/sanitize-html": "2.16.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "ws": "8.21.3",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
