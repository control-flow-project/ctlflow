{
  "name": "ctlflow",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "workspaces": [
    "services/*",
    "testing/*"
  ],
  "scripts": {
    "build": "hugo --gc --minify --cleanDestinationDir",
    "dev": "hugo server --bind 0.0.0.0 --port 7780 --disableFastRender",
    "build:tenantd": "npm run build --workspace @ctlflow/test-mesh && npm run build --workspace @ctlflow/tenantd",
    "test:tenantd": "npm run test --workspace @ctlflow/tenantd",
    "test:tooling": "node --test tooling/native/*.test.mjs",
    "verify:container:tenantd": "docker build --network=host -f services/tenantd/csharp/Containerfile -t ctlflow-tenantd:verify .",
    "update:diagnostics:tenantd": "node tooling/native/gated-publish.mjs services/tenantd/csharp/src/CtlFlow.Tenancy.Tenantd.Service/CtlFlow.Tenancy.Tenantd.Service.csproj services/tenantd/csharp/nativeaot-diagnostics.json /tmp/ctlflow-tenantd-diag --write"
  },
  "devDependencies": {
    "hugo-bin": "0.149.2"
  }
}
