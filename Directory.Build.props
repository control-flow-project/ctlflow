<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)'=='Crossfire.EfHost' And '$(CrossfireEfTargetName)'!=''">
    <BaseIntermediateOutputPath>obj/$(CrossfireEfTargetName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(CrossfireEfTargetName)/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Version>0.1.20</Version>
    <Authors>Jeswin P Kumar</Authors>
    <Company>Control Flow</Company>
    <Copyright>Copyright 2026 Jeswin P Kumar (jeswinpk@agilehead.com)</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IsPackable>false</IsPackable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>
</Project>
