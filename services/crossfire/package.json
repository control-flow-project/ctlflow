{
  "name": "@ctlflow/crossfire",
  "version": "0.1.4",
  "private": true,
  "bin": {
    "crossfire": "./crossfire"
  },
  "type": "module",
  "description": "Human-led Matrix coordination and agent management",
  "devDependencies": {
    "@ctlflow/crossfire-test-support": "0.1.4",
    "@ctlflow/crossfire-operator-support": "0.1.4",
    "@ctlflow/crossfire-adapter-crossfire": "0.1.4",
    "@ctlflow/crossfire-adapter-matrix": "0.1.4",
    "@ctlflow/crossfire-adapter-sqlite": "0.1.4",
    "@ctlflow/crossfire-adapter-filesystem": "0.1.4",
    "@ctlflow/crossfire-contracts": "0.1.4",
    "@ctlflow/crossfire-kernel": "0.1.4",
    "@tinqerjs/better-sqlite3-adapter": "0.0.28",
    "better-sqlite3": "13.0.3",
    "@playwright/test": "1.63.0",
    "@ctlflow/crossfire-agent-tools": "0.1.4",
    "@ctlflow/fleet": "0.1.4",
    "@ctlflow/fleetd-contracts": "0.1.4"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "build": "node ../../scripts/build-service.mjs crossfire",
    "test": "node ../../scripts/test.mjs crossfire all",
    "test:browser": "node ../../scripts/test.mjs crossfire browser",
    "test:integration": "node ../../scripts/test.mjs crossfire integration",
    "generate:matrix": "npm run build && node dist/scripts/generate-matrix-api.js",
    "start": "node crossfire start",
    "crossfire": "node crossfire",
    "tools": "node dist/tools/main.js",
    "verify:architecture": "node scripts/verify-architecture.ts",
    "verify:installation": "node scripts/verify-architecture.ts installation",
    "verify:container": "node dist/scripts/verify-container.js"
  }
}
