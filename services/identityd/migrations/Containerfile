FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131 AS build

WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY tooling/clean-directories.mjs tooling/clean-directories.mjs
COPY services/identityd/package.json services/identityd/package.json
RUN npm ci \
    --workspace @ctlflow/identityd \
    --include-workspace-root=false

COPY services/identityd/knexfile.ts services/identityd/knexfile.ts
COPY services/identityd/migrations services/identityd/migrations
COPY services/identityd/schema-manifest.txt \
    services/identityd/schema-manifest.txt
COPY services/identityd/tooling services/identityd/tooling
COPY services/identityd/tsconfig.migrations.json \
    services/identityd/tsconfig.migrations.json
RUN npm run build:migrations --workspace @ctlflow/identityd
RUN npm run verify:schema-manifest --workspace @ctlflow/identityd
RUN npm prune \
    --omit=dev \
    --workspace @ctlflow/identityd \
    --include-workspace-root=false

FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131

WORKDIR /workspace
COPY --from=build /workspace/node_modules /workspace/node_modules
COPY --from=build /workspace/services/identityd/package.json \
    /workspace/services/identityd/package.json
COPY --from=build /workspace/services/identityd/.generated \
    /workspace/services/identityd/.generated

USER 65532:65532
ENTRYPOINT ["node", "/workspace/services/identityd/.generated/migrations/tooling/migrations/run.js"]
