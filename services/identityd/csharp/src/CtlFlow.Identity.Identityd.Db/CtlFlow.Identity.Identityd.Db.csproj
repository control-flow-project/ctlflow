<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CtlFlow.Identity.Identityd.Db</AssemblyName>
    <RootNamespace>CtlFlow.Identity.Identityd.Db</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
    <EFTargetNamespace>CtlFlow.Identity.Identityd.Db.Generated</EFTargetNamespace>
    <EFOptimizeContext Condition="'$(Configuration)' == 'Release'">true</EFOptimizeContext>
    <EFStartupProject>../CtlFlow.Identity.Identityd.Service/CtlFlow.Identity.Identityd.Service.csproj</EFStartupProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CtlFlow.Identity.Identityd.Domain/CtlFlow.Identity.Identityd.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="CtlFlow.Identity.Identityd.Domain.Accounts" />
    <Using Include="CtlFlow.Identity.Identityd.Domain.Groups" />
    <Using Include="CtlFlow.Identity.Identityd.Domain.IdentityLinks" />
    <Using Include="CtlFlow.Identity.Identityd.Domain.Memberships" />
    <Using Include="CtlFlow.Identity.Identityd.Domain.Principals" />
    <Using Include="CtlFlow.Identity.Identityd.Domain.Providers" />
    <Using Include="CtlFlow.Identity.Identityd.Domain.Resources" />
    <Using Include="CtlFlow.Identity.Identityd.Domain.Sessions" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../schema-manifest.txt"
                      LogicalName="CtlFlow.Identity.Identityd.SchemaManifest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
</Project>
