FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131 AS build

WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY tooling/clean-directories.mjs tooling/clean-directories.mjs
COPY services/tenantd/package.json services/tenantd/package.json
RUN npm ci \
    --workspace @ctlflow/tenantd \
    --include-workspace-root=false

COPY services/tenantd/knexfile.ts services/tenantd/knexfile.ts
COPY services/tenantd/migrations services/tenantd/migrations
COPY services/tenantd/schema-manifest.txt \
    services/tenantd/schema-manifest.txt
COPY services/tenantd/tooling services/tenantd/tooling
COPY services/tenantd/tsconfig.migrations.json \
    services/tenantd/tsconfig.migrations.json
RUN npm run build:migrations --workspace @ctlflow/tenantd
RUN npm run verify:schema-manifest --workspace @ctlflow/tenantd
RUN npm prune \
    --omit=dev \
    --workspace @ctlflow/tenantd \
    --include-workspace-root=false

FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131

WORKDIR /workspace
COPY --from=build /workspace/node_modules /workspace/node_modules
COPY --from=build /workspace/services/tenantd/package.json \
    /workspace/services/tenantd/package.json
COPY --from=build /workspace/services/tenantd/.generated \
    /workspace/services/tenantd/.generated

USER 65532:65532
ENTRYPOINT ["node", "/workspace/services/tenantd/.generated/migrations/tooling/migrations/run.js"]
