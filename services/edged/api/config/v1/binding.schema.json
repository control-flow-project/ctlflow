{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ctlflow.com/edged/config/v1/binding.schema.json",
  "title": "CtlFlow Edged binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "upstream_port"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant_id"
          ],
          "properties": {
            "tenant_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant_id",
            "workspace_id"
          ],
          "properties": {
            "tenant_id": {
              "$ref": "#/$defs/identifier"
            },
            "workspace_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "upstream_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    }
  }
}
