{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ctlflow.com/egressd/config/v1/secrets.schema.json",
  "title": "CtlFlow Egressd binding secrets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "values"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "values": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[\\x20-\\x7E]+$"
          }
        }
      }
    }
  }
}
