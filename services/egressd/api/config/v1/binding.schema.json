{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ctlflow.com/egressd/config/v1/binding.schema.json",
  "title": "CtlFlow Egressd binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "caller",
    "origin",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "binding_id": {
      "$ref": "#/$defs/identifier"
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "service_account"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/dnsLabel"
        },
        "service_account": {
          "$ref": "#/$defs/dnsLabel"
        }
      }
    },
    "origin": {
      "type": "string",
      "format": "uri",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?::[0-9]{1,5})?/?$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "headerName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*[?%#\\\\])(?:[\\x21-\\x7E]*[\\x21-\\x2E\\x30-\\x7E])?$"
    },
    "headerValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[\\x20-\\x7E]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "secret_name"
          ],
          "properties": {
            "secret_name": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "setHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/headerName"
        },
        "value": {
          "$ref": "#/$defs/headerValue"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "methods",
        "match",
        "upstream_path_prefix",
        "forward_request_headers",
        "forward_response_headers",
        "set_request_headers",
        "maximum_request_body_bytes",
        "maximum_response_body_bytes",
        "forward_trace_context"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          }
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "exact",
                "prefix"
              ]
            },
            "path": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "upstream_path_prefix": {
          "$ref": "#/$defs/path"
        },
        "forward_request_headers": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/headerName"
          }
        },
        "forward_response_headers": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/headerName"
          }
        },
        "set_request_headers": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/setHeader"
          }
        },
        "maximum_request_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maximum_response_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "forward_trace_context": {
          "type": "boolean"
        }
      }
    }
  }
}
