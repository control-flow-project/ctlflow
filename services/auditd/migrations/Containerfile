FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131 AS build

WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY tooling/clean-directories.mjs tooling/clean-directories.mjs
COPY services/auditd/package.json services/auditd/package.json
RUN npm ci \
    --workspace @ctlflow/auditd \
    --include-workspace-root=false

COPY services/auditd/knexfile.ts services/auditd/knexfile.ts
COPY services/auditd/migrations services/auditd/migrations
COPY services/auditd/schema-manifest.txt \
    services/auditd/schema-manifest.txt
COPY services/auditd/tooling services/auditd/tooling
COPY services/auditd/tsconfig.migrations.json \
    services/auditd/tsconfig.migrations.json
RUN npm run build:migrations --workspace @ctlflow/auditd
RUN npm run verify:schema-manifest --workspace @ctlflow/auditd
RUN npm prune \
    --omit=dev \
    --workspace @ctlflow/auditd \
    --include-workspace-root=false

FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131

WORKDIR /workspace
COPY --from=build /workspace/node_modules /workspace/node_modules
COPY --from=build /workspace/services/auditd/package.json \
    /workspace/services/auditd/package.json
COPY --from=build /workspace/services/auditd/.generated \
    /workspace/services/auditd/.generated

USER 65532:65532
ENTRYPOINT ["node", "/workspace/services/auditd/.generated/migrations/tooling/migrations/run.js"]
