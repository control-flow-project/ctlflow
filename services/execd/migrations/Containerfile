FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131 AS build

WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY tooling/clean-directories.mjs tooling/clean-directories.mjs
COPY services/execd/package.json services/execd/package.json
RUN npm ci \
    --workspace @ctlflow/execd \
    --include-workspace-root=false

COPY services/execd/knexfile.ts services/execd/knexfile.ts
COPY services/execd/migrations services/execd/migrations
COPY services/execd/schema-manifest.txt \
    services/execd/schema-manifest.txt
COPY services/execd/tooling services/execd/tooling
COPY services/execd/tsconfig.migrations.json \
    services/execd/tsconfig.migrations.json
RUN npm run build:migrations --workspace @ctlflow/execd
RUN npm run verify:schema-manifest --workspace @ctlflow/execd
RUN npm prune \
    --omit=dev \
    --workspace @ctlflow/execd \
    --include-workspace-root=false

FROM node:26.1.0-bookworm-slim@sha256:8c676dbdbfc322815df09c910e80685fc5de08baa21c3b6189627e302b1bf131

WORKDIR /workspace
COPY --from=build /workspace/node_modules /workspace/node_modules
COPY --from=build /workspace/services/execd/package.json \
    /workspace/services/execd/package.json
COPY --from=build /workspace/services/execd/.generated \
    /workspace/services/execd/.generated

USER 65532:65532
ENTRYPOINT ["node", "/workspace/services/execd/.generated/migrations/tooling/migrations/run.js"]
