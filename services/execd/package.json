{
  "name": "@ctlflow/execd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node tests/support/generate-client.mjs",
    "update:api-manifest": "node tooling/api/update-api-manifest.mjs",
    "verify:api-manifest": "node tooling/api/verify-api-manifest.mjs",
    "build:migrations": "node ../../tooling/clean-directories.mjs .generated/migrations && tsc --project tsconfig.migrations.json",
    "update:schema-manifest": "npm run build:migrations && node tooling/schema/update-schema-manifest.mjs",
    "verify:schema-manifest": "node tooling/schema/verify-schema-manifest.mjs",
    "verify:architecture": "node tooling/architecture/verify-implementation.mjs",
    "verify:evidence": "node tooling/evidence/verify-evidence-manifest.mjs",
    "verify:kubernetes-contract": "node tooling/kubernetes/verify-dependency-claim.mjs",
    "build:application": "node ../../tooling/clean-directories.mjs .generated/testing/application/node && tsc --project testing/application/node/tsconfig.json",
    "build:tests": "node ../../tooling/clean-directories.mjs tests/dist && tsc --project tests/tsconfig.json",
    "build": "npm run build:migrations && npm run verify:schema-manifest && npm run verify:api-manifest && npm run verify:architecture && npm run verify:kubernetes-contract && npm run build:application && npm run generate && npm run build:tests && npm run verify:evidence",
    "migrate": "npm run build:migrations && node .generated/migrations/tooling/migrations/run.js",
    "test": "npm run test:compiled && npm run test:csharp",
    "test:compiled": "node --test --test-force-exit --test-isolation=none --test-concurrency=1 --test-global-setup=./tests/dist/suite/setup-execd-test-suite.js tests/dist/integration/execd.test.js",
    "test:csharp": "node csharp/tests/run-model-audit.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "knex": "3.1.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@ctlflow/auditd": "0.0.0",
    "@ctlflow/configd": "0.0.0",
    "@ctlflow/identityd": "0.0.0",
    "@ctlflow/pkgd": "0.0.0",
    "@ctlflow/policyd": "0.0.0",
    "@ctlflow/test-mesh": "0.0.0",
    "@grpc/grpc-js": "1.14.4",
    "@types/node": "24.10.1",
    "grpc-tools": "1.13.0",
    "long": "5.3.2",
    "protobufjs": "7.6.4",
    "ts-proto": "2.8.3",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
