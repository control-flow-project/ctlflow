<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>CtlFlow.Execution.Execd.Service</AssemblyName>
    <RootNamespace>CtlFlow.Execution.Execd.Service</RootNamespace>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SelfContained>true</SelfContained>
    <OptimizationPreference>Speed</OptimizationPreference>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <TrimmerTreatWarningsAsErrors>true</TrimmerTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>false</SuppressAotAnalysisWarnings>
    <SuppressSingleFileAnalysisWarnings>false</SuppressSingleFileAnalysisWarnings>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
    <EFScaffoldModelStage>none</EFScaffoldModelStage>
    <EFPrecompileQueriesStage>none</EFPrecompileQueriesStage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CtlFlow.Execution.Execd.Domain/CtlFlow.Execution.Execd.Domain.csproj" />
    <ProjectReference Include="../CtlFlow.Execution.Execd.Db/CtlFlow.Execution.Execd.Db.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../../api/proto/v1/execd.proto"
              GrpcServices="Server"
              ProtoRoot="../../../api/proto" />
    <Protobuf Include="../../../../auditd/api/proto/v1/auditd.proto"
              GrpcServices="Client"
              ProtoRoot="../../../../auditd/api/proto" />
    <Protobuf Include="../../../../configd/api/proto/v1/configd.proto"
              GrpcServices="Client"
              ProtoRoot="../../../../configd/api/proto" />
    <Protobuf Include="../../../../identityd/api/proto/v1/identityd.proto"
              GrpcServices="Client"
              ProtoRoot="../../../../identityd/api/proto" />
    <Protobuf Include="../../../../pkgd/api/proto/v1/pkgd.proto"
              GrpcServices="Client"
              ProtoRoot="../../../../pkgd/api/proto" />
    <Protobuf Include="../../../../policyd/api/proto/v1/policyd.proto"
              GrpcServices="Client"
              ProtoRoot="../../../../policyd/api/proto" />
  </ItemGroup>
</Project>
