<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CtlFlow.Configuration.Configd.Db</AssemblyName>
    <RootNamespace>CtlFlow.Configuration.Configd.Db</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
    <EFTargetNamespace>CtlFlow.Configuration.Configd.Db.Generated</EFTargetNamespace>
    <EFOptimizeContext Condition="'$(Configuration)' == 'Release'">true</EFOptimizeContext>
    <EFStartupProject>../CtlFlow.Configuration.Configd.Service/CtlFlow.Configuration.Configd.Service.csproj</EFStartupProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CtlFlow.Configuration.Configd.Domain/CtlFlow.Configuration.Configd.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../schema-manifest.txt"
                      LogicalName="CtlFlow.Configuration.Configd.SchemaManifest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
</Project>
