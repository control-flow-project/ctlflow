{
  "name": "@ctlflow/fleet",
  "version": "0.1.3",
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "devDependencies": { "@ctlflow/crossfire-test-support": "0.1.3" },
  "bin": { "fleet": "./dist/bin/fleet.mjs" },
  "files": ["dist/bin", "docs", "README.md"],
  "exports": { "./executable": "./dist/bin/fleet.mjs", "./package.json": "./package.json" },
  "dependencies": { "@ctlflow/fleetd": "0.1.3" },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../scripts/build-service.mjs fleet",
    "build:package": "node scripts/build-package.mjs",
    "test": "node ../../scripts/test.mjs fleet all"
  }
}
